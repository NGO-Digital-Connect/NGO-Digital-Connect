# ==============================================================================
# NGO DIGITAL CONNECT - SERVER ENVIRONMENT CONFIGURATION
# ==============================================================================
PORT=5000
FRONTEND_URL=http://localhost:5173

# Supabase Server-Side Admin Access (Bypasses RLS for subscriptions & payment_events)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Razorpay Subscriptions Credentials (Test Mode or Live)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay Webhook Secret (HMAC SHA-256 signature verification)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Razorpay Plan IDs (Created in Razorpay Dashboard -> Subscriptions -> Plans)
RAZORPAY_PLAN_ID_PRO=plan_xxxxxxxxxxxxxx
RAZORPAY_PLAN_ID_ENTERPRISE=plan_yyyyyyyyyyyyyy
