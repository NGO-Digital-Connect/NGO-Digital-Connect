# ==============================================================================
# NGO DIGITAL CONNECT - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env (or server/.env) and fill in your actual credentials.
# NEVER commit production API keys, service role keys, or secrets into source control!
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite - Exposed to browser)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key
VITE_API_BASE_URL=http://localhost:5000/api
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id

# ------------------------------------------------------------------------------
# BACKEND SERVER CONFIGURATION (Node.js Express - Stays strictly on server)
# ------------------------------------------------------------------------------
PORT=5000
FRONTEND_URL=http://localhost:5173

# Supabase Server-Side Admin Access (Bypasses RLS for subscription writes & webhooks)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Razorpay Subscriptions Credentials (Test Mode or Live)
# Found at: Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay Webhook Secret (HMAC SHA-256 signature verification)
# Created at: Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Razorpay Plan IDs (Created in Razorpay Dashboard -> Subscriptions -> Plans)
# Billing cycle must be Monthly with the respective plan amounts in INR
RAZORPAY_PLAN_ID_PRO=plan_xxxxxxxxxxxxxx
RAZORPAY_PLAN_ID_ENTERPRISE=plan_yyyyyyyyyyyyyy
